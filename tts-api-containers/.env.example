# docker compose が読む設定。cp .env.example .env して使う

# 起動時に読み込むモデル。一覧は GET /v1/models
IRODORI_DEFAULT_MODEL=irodori-v4.1-small
IRODORI_PRELOAD=1
# bf16 / fp32。量子化版でも、量子化されていない層と演算の精度はこれで決まる
IRODORI_MODEL_PRECISION=bf16
IRODORI_WATERMARK=1
GPU_ID=0

# ホスト公開ポート（22500-22599 の範囲内に限る）
API_HOST_PORT=22500
CHAT_HOST_PORT=22501
